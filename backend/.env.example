# Copy this file to .env and fill in your real values.
# Never commit .env to version control. .env is listed in .gitignore.

# -- Server -----------------------------------------------------------
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# -- Supabase (database, auth, storage) -------------------------------
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# -- AI text generation (ANI / scripts) - Ollama local open-source ----
# Install Ollama and pull a small model, e.g.:
#   ollama pull llama3.2:3b
LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# -- Supabase Auth ----------------------------------------------------
# Supported sign-in: email magic link / OTP (passwordless).

# -- Video engine - open-weight/self-hosted (modular) -----------------
# Kaggle GPU notebook API is for development/experimentation only.
VIDEO_ENGINE=kaggle
KAGGLE_VIDEO_API_URL=https://YOUR_KAGGLE_NB_ENDPOINT
KAGGLE_VIDEO_API_KEY=YOUR_KAGGLE_VIDEO_API_KEY
VIDEO_MODEL=wan-2.2-ti2v-5b

# -- Image generation - self-hosted/open-source HTTP endpoint ---------
# No paid image APIs. Use IMAGE_PROVIDER=http with your endpoint, or 'none'.
IMAGE_PROVIDER=none
IMAGE_PROVIDER_URL=http://127.0.0.1:7860
# IMAGE_PROVIDER_API_KEY=
# IMAGE_TIMEOUT_MS=120000

# -- Text-to-speech (Piper TTS, OHF-Voice/piper1-gpl) ---------------
TTS_PROVIDER=piper
PIPER_TTS_URL=http://127.0.0.1:5000
PIPER_VOICE=en_US-lessac-medium
# TTS_SPEAKING_RATE=1.0
# TTS_TIMEOUT_MS=120000

# -- Email notifications (Resend, optional) ---------------------------
# Dashboard notifications are always available in-app.
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# -- Storage / FFmpeg / Security / Worker -----------------------------
SUPABASE_STORAGE_BUCKET_VIDEOS=anilearn-videos
SUPABASE_STORAGE_BUCKET_IMAGES=anilearn-images
SUPABASE_STORAGE_BUCKET_THUMBNAILS=anilearn-thumbnails
FFMPEG_BIN=ffmpeg
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_GENERATION_MAX=5
WORKER_POLL_INTERVAL_MS=5000
VIDEO_MAX_POLLS=60
VIDEO_POLL_INTERVAL_MS=10000
TERMS_VERSION=1.1
PRIVACY_VERSION=1.1
